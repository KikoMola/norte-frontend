{
  "name": "norte-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "ng run norte-front:storybook",
    "build-storybook": "ng run norte-front:build-storybook",
    "api:sync": "node scripts/api-sync.mjs",
    "api:generate": "orval --config orval.config.ts",
    "prestart": "npm run api:generate",
    "prebuild": "npm run api:generate",
    "pretest": "npm run api:generate",
    "prelint": "npm run api:generate",
    "start:mock": "ng serve --configuration mock",
    "prestart:mock": "npm run api:generate",
    "e2e": "playwright test",
    "pree2e": "npm run api:generate",
    "e2e:storybook": "E2E_STORYBOOK=1 playwright test --project=storybook"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.7",
    "@angular/compiler": "22.2.7",
    "@angular/core": "22.2.7",
    "@angular/forms": "22.2.7",
    "@angular/platform-browser": "22.2.7",
    "@angular/router": "22.2.7",
    "@floating-ui/dom": "1.8.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/lucide": "36.1.0",
    "@ngx-translate/core": "18.1.0",
    "@ngx-translate/http-loader": "18.1.0",
    "@tanstack/angular-table": "9.3.2",
    "@tanstack/charts": "1.5.0",
    "ng-primitives": "0.132.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.8",
    "@angular/build": "22.2.8",
    "@angular/cli": "22.2.8",
    "@angular/compiler-cli": "22.2.7",
    "@angular/platform-browser-dynamic": "22.2.7",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-themes": "10.6.8",
    "@storybook/angular": "10.6.8",
    "@tailwindcss/postcss": "4.3.5",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-boundaries": "7.4.4",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "msw-storybook-addon": "3.0.3",
    "orval": "8.49.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0",
    "npm": ">=11"
  },
  "overrides": {
    "@storybook/builder-webpack5": {
      "webpack-dev-middleware": "7.4.6"
    },
    "fork-ts-checker-webpack-plugin": {
      "minimatch": "11.0.9"
    }
  },
  "msw": {
    "workerDirectory": [
      "src/mock-public"
    ]
  }
}
